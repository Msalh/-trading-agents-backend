# Must match exactly the "Market State Webhook Secret" input value
# set inside the Pine Script indicator on TradingView.
WEBHOOK_SECRET=change-me-to-a-long-random-value

# Needed for the Analysis Agent (Sprint 3). Get one from
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Sprint 4 — News Agent background scheduler. Set to "true" only on
# the deployed instance; leave unset/false for local testing so a
# timer doesn't fire paid API calls while you're developing.
ENABLE_SCHEDULER=false
NEWS_SYMBOL=MNQ1!
NEWS_INTERVAL_MINUTES=60

# Sprint 5 — Macro/Correlation Agent. Defaults to NEWS_SYMBOL if unset.
MACRO_SYMBOL=MNQ1!
MACRO_INTERVAL_MINUTES=60

# Sprint 6 — Coordinator. Placeholder threshold, needs real tuning
# against historical/replayed data before going live.
COORDINATOR_THRESHOLD=25

# Tier-1 safety fixes (external review, Aug 2026)
MIN_AVAILABLE_WEIGHT=0.6
ANALYSIS_MAX_AGE_MINUTES=15
NEWS_MACRO_MAX_AGE_MINUTES=90
MIN_REWARD_RISK_RATIO=1.0

# Tier 2.1 — immutable trade-candidate lifecycle (external review, Aug 2026)
CANDIDATE_MAX_AGE_MINUTES=20

# Sprint 7 — Risk Agent. Static/manual account state (no live broker
# connection yet) — update these by hand as your real account balance
# and drawdown usage change. Tier 2.2: Risk now sizes positions from
# Execution's actual entry/stop distance instead of an ATR estimate —
# no new env vars needed, same account-state inputs as before.
ACCOUNT_BALANCE=50000
MAX_DRAWDOWN=2000
CURRENT_DRAWDOWN_USED=0
# Tier 3.3: enforced ACCOUNT-WIDE (across every symbol/timeframe), not
# as a separate limit per symbol — a single account-wide budget of
# live (pending_fill/open) paper trades, atomically reserved in
# app/storage.open_trade_if_room().
MAX_OPEN_POSITIONS=1
# Tier 2.3: CURRENT_OPEN_POSITIONS is now a FALLBACK only — Risk's gate
# stage normally uses the live ACCOUNT-WIDE count of open/pending paper
# trades (app/paper_trades.get_account_open_trade_count()) instead.
# Only matters for standalone calls that don't go through main.py's
# endpoints (e.g. direct unit tests).
CURRENT_OPEN_POSITIONS=0
BASE_POSITION_SIZE=1
# Tier 3.3: a trade's actual budget is now min(RISK_FRACTION_PER_TRADE
# of remaining drawdown room, remaining daily-loss room) — whichever
# is tighter right now, not drawdown room alone.
RISK_FRACTION_PER_TRADE=0.5

# Tier 2.10 — account-level risk controls (external review, Aug 2026).
# Like CURRENT_OPEN_POSITIONS above, CURRENT_DRAWDOWN_USED is now a
# FALLBACK only — Risk normally uses the LIVE peak-to-trough drawdown
# computed from real closed paper trades (app/account_risk.py)
# instead. You generally don't need to hand-update it anymore; it only
# matters for standalone calls that don't go through main.py's
# endpoints. DAILY_LOSS_LIMIT is a new, separate, time-boxed circuit
# breaker (also live-computed, no manual update needed) — stops new
# trades for the rest of the trading day once today's realized losses
# reach this dollar amount, independent of the overall MAX_DRAWDOWN.
DAILY_LOSS_LIMIT=1000

# Tier 3.2 — paper-trade fill realism (second external review, Aug 2026).
# ORDER_EXPIRY_MINUTES: a pending order (limit, or a market order still
# waiting for the next bar) is cancelled instead of resting forever
# once this many EVENT-time minutes have passed since it was
# submitted. SLIPPAGE_POINTS: applied against the trader on market
# entry fills and on stop-loss exits (a stop is effectively a market
# order once triggered) — limit and target fills stay exact, no
# slippage. COMMISSION_PER_CONTRACT: a flat round-trip commission per
# contract, subtracted from pnl_usd on every closed trade. Defaults
# below are reasonable approximations for MNQ micro futures, not a
# calibration to any specific broker's real schedule.
ORDER_EXPIRY_MINUTES=60
SLIPPAGE_POINTS=0.25
COMMISSION_PER_CONTRACT=2.0
